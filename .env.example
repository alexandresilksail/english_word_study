# ============================================================
# 复制本文件为 .env 后按实际情况修改（.env 不要提交到 Git）
# ============================================================

# 运行模式：development / production
FLASK_ENV=production

# 【必须】会话与 CSRF 签名密钥 —— 生产环境务必更换！
# 生成方式： python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=please-change-this-to-a-long-random-string

# 【必须】你的域名（多个用逗号分隔；不要写 http:// 前缀）
DOMAIN=www.example.com

# 【可选】站点标题
APP_TITLE_CN=英语单词学习

# 【可选】数据库连接串
# 第一版默认使用容器内的 SQLite（数据保存在宿主机 ./data 目录）
# 将来迁移 MySQL / PostgreSQL 只需改成：
#   DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname?charset=utf8mb4
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
# DATABASE_URL=sqlite:////app/instance/english_word_study.db

# 【可选】首次部署时自动创建的管理员账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345

# 【可选】HTTPS 下强制使用安全 Cookie
SESSION_COOKIE_SECURE=true

# ============================================================
# 邮件服务（邮箱验证码登录 / 注册 需要）
# ------------------------------------------------------------
# 不配置时系统不会崩溃：验证码会直接显示在页面上（仅用于本地自测），
# 但线上必须配置，否则用户收不到验证码。
#
# 常见配置示例：
#   QQ 邮箱      MAIL_SERVER=smtp.qq.com      MAIL_PORT=465  MAIL_USE_TLS=false（465 为 SSL，见注）
#   163 邮箱     MAIL_SERVER=smtp.163.com     MAIL_PORT=465
#   Gmail        MAIL_SERVER=smtp.gmail.com   MAIL_PORT=587  MAIL_USE_TLS=true
#   腾讯企业邮   MAIL_SERVER=smtp.exmail.qq.com MAIL_PORT=465
# 注：端口 465 走隐式 SSL，本项目使用 starttls；如遇握手失败请改用 587。
# 密码请填「SMTP 授权码 / 应用专用密码」，不是邮箱登录密码。
# ============================================================
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=you@example.com
# MAIL_PASSWORD=your-smtp-authorization-code
# MAIL_FROM=you@example.com

# ============================================================
# V5.7 AI Tutor（可选）
# ------------------------------------------------------------
# 不配置 AI_API_KEY 时，AI Tutor 运行在「本地规则模式」：
# 结果由站内已有内容数据按规则生成，UI 会明确标注这是本地规则而非大模型回答。
# 配置后自动切换为真实模型，无需改任何代码。
#
# 支持的 provider：openai / anthropic / mock（显式留空以保持本地规则模式）
# ============================================================
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-key-here          # 只写在这里，绝不提交到 Git
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1  # 走代理/兼容网关时可改
# AI_TIMEOUT=20
# AI_MAX_INPUT_CHARS=2000
