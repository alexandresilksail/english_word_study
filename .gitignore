# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境与密钥（切勿提交）
.env

# 数据库与运行时数据
# ⚠️ 必须加 "/" 前缀锚定到项目根目录：不带前缀的 "data/" 会匹配任意层级，
#    从而误伤源码资源 app/data/（2000 词库 words.json），导致部署后词表为空。
instance/*.db
instance/*.db-journal
/data/
/logs/
/backups/
/certbot/
nginx/conf.d/app.conf

# 测试
.pytest_cache/
.coverage

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
