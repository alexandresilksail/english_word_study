/* app.wxss —— 全局样式（设计系统：紫靛主色 + 卡片式布局） */

page {
  background: #f5f6fb;
  color: #1e293b;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* ---------- 布局 ---------- */
.page { padding: 24rpx; padding-bottom: 40rpx; }
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(99, 102, 241, 0.06);
}
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.gap-12 { gap: 24rpx; }
.gap-8 { gap: 16rpx; }
.flex-1 { flex: 1; min-width: 0; }

/* ---------- 文字 ---------- */
.title { font-size: 34rpx; font-weight: 700; color: #0f172a; }
.subtitle { font-size: 26rpx; color: #64748b; }
.muted { color: #94a3b8; font-size: 24rpx; }
.strong { font-weight: 600; }
.text-center { text-align: center; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.gradient-text {
  background: linear-gradient(135deg, #8b5cf6, #6366f1);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 999rpx;
  padding: 22rpx 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-primary {
  background: linear-gradient(135deg, #8b5cf6, #6366f1);
  color: #ffffff;
}
.btn-primary[disabled] { opacity: 0.5; color: #ffffff; }
.btn-ghost {
  background: #eef2ff;
  color: #4f46e5;
}
.btn-danger { background: #fee2e2; color: #dc2626; }
.btn-block { width: 100%; }
.btn-sm { padding: 12rpx 28rpx; font-size: 24rpx; }

/* ---------- 插画 ---------- */
.ill {
  display: block;
  object-fit: contain;
}
.ill-entry { width: 96rpx; height: 96rpx; }
.ill-card { width: 128rpx; height: 128rpx; }
.ill-hero { width: 260rpx; height: 260rpx; margin: 0 auto; }
.ill-empty { width: 220rpx; height: 220rpx; margin: 0 auto 24rpx; }

/* ---------- 功能入口网格 ---------- */
.entry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}
.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 8rpx;
  background: #ffffff;
  border-radius: 20rpx;
}
.entry text { font-size: 22rpx; color: #475569; }

/* ---------- 统计数字 ---------- */
.stat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20rpx; }
.stat {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx;
  text-align: center;
}
.stat-num { font-size: 40rpx; font-weight: 700; color: #4f46e5; }
.stat-label { font-size: 22rpx; color: #94a3b8; margin-top: 6rpx; }

/* ---------- 进度条 ---------- */
.bar {
  height: 16rpx;
  background: #e2e8f0;
  border-radius: 999rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #8b5cf6, #6366f1);
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

/* ---------- 列表项 ---------- */
.list-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.list-item:last-child { border-bottom: none; }
.word-en { font-size: 30rpx; font-weight: 600; color: #0f172a; }
.word-cn { font-size: 24rpx; color: #64748b; margin-top: 4rpx; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: #eef2ff;
  color: #4f46e5;
}
.tag-green { background: #dcfce7; color: #16a34a; }
.tag-red { background: #fee2e2; color: #dc2626; }
.tag-amber { background: #fef3c7; color: #d97706; }

/* ---------- 状态：加载 / 空 / 错误 ---------- */
.state-box {
  padding: 80rpx 40rpx;
  text-align: center;
}
.state-text { color: #94a3b8; font-size: 26rpx; margin-bottom: 24rpx; }

/* ---------- 安全区 ---------- */
.safe-bottom { height: env(safe-area-inset-bottom); }
