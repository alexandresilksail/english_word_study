/* pages/login/login.wxss */

.login-page { padding-top: 60rpx; }

.brand { text-align: center; margin-bottom: 48rpx; }
.brand-title { font-size: 48rpx; font-weight: 800; margin-top: 24rpx; }
.brand-sub { font-size: 24rpx; color: #94a3b8; margin-top: 12rpx; }

.form-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}
.form-label { font-size: 26rpx; color: #475569; width: 96rpx; flex-shrink: 0; }
.form-input { flex: 1; font-size: 28rpx; color: #0f172a; }

.dev-code {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 24rpx;
  border-radius: 12rpx;
  text-align: center;
}

button[disabled] { opacity: 0.55; }

.link { color: #4f46e5; text-decoration: underline; }
