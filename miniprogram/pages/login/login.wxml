<!-- pages/login/login.wxml -->
<view class="page login-page">
  <!-- 品牌区 -->
  <view class="brand">
    <image class="ill ill-hero" src="/images/home.png" mode="aspectFit" />
    <view class="brand-title gradient-text">PolyGo</view>
    <view class="brand-sub">2000 核心词 · 四种测试模式 · 学习进度全记录</view>
  </view>

  <!-- 微信登录 -->
  <view class="card">
    <view class="row-between" style="margin-bottom: 20rpx;">
      <text class="title">微信快捷登录</text>
      <image class="ill" src="/images/speaking.png" mode="aspectFit"
             style="width:56rpx;height:56rpx;" />
    </view>
    <view class="subtitle" style="margin-bottom: 24rpx;">
      首次登录将自动创建账户，学习记录保存在云端，换设备不丢失。
    </view>
    <button class="btn btn-primary btn-block" bindtap="onWxLogin" disabled="{{ logging }}">
      {{ logging ? '登录中…' : '微信一键登录' }}
    </button>
    <view class="muted text-center" style="margin-top: 16rpx;">
      登录即表示同意<text class="link" bindtap="openLegal">《用户协议》</text>与<text class="link" bindtap="openLegal">《隐私政策》</text>
    </view>
  </view>

  <!-- 绑定已有账户 -->
  <view class="card">
    <view class="row-between" style="margin-bottom: 20rpx;">
      <text class="title">绑定已有账户</text>
      <image class="ill" src="/images/course.png" mode="aspectFit"
             style="width:56rpx;height:56rpx;" />
    </view>
    <view class="subtitle" style="margin-bottom: 24rpx;">
      在网页版已有账户？绑定后可同步之前的单词进度、收藏与错题。
      为证明你是该账户的主人，需要验证邮箱控制权。
    </view>

    <view class="form-row">
      <text class="form-label">邮箱</text>
      <input class="form-input" type="text" placeholder="请输入账户邮箱"
             value="{{ bindEmail }}" bindinput="onEmailInput" />
    </view>

    <view class="form-row">
      <text class="form-label">密码</text>
      <input class="form-input" password type="text" placeholder="该账户的登录密码"
             value="{{ bindPassword }}" bindinput="onPasswordInput" />
    </view>

    <view class="row gap-8" style="margin-bottom: 20rpx;">
      <button class="btn btn-ghost btn-sm flex-1" bindtap="onSendCode" disabled="{{ sendingCode }}">
        {{ sendingCode ? '发送中…' : '改用邮箱验证码' }}
      </button>
      <button class="btn btn-ghost btn-sm flex-1" bindtap="toggleUseCode" disabled="{{ useCode }}">
        {{ useCode ? '改用密码验证' : '使用密码验证' }}
      </button>
    </view>

    <view wx:if="{{ useCode }}" class="form-row">
      <text class="form-label">验证码</text>
      <input class="form-input" type="number" maxlength="6" placeholder="6 位验证码"
             value="{{ bindCode }}" bindinput="onCodeInput" />
    </view>

    <button class="btn btn-primary btn-block" bindtap="onBind"
            disabled="{{ binding || (!bindEmail || (!bindPassword && !bindCode)) }}">
      {{ binding ? '绑定中…' : '绑定并登录' }}
    </button>
    <view wx:if="{{ devCode }}" class="dev-code">
      （未配置邮件服务）验证码：{{ devCode }}
    </view>
  </view>
</view>
