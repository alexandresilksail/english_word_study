.legal { padding: 24rpx 24rpx 64rpx; }

.section { padding: 28rpx; margin-bottom: 24rpx; }

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #312e81;
  margin-bottom: 16rpx;
}

.item {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eef0f6;
  font-size: 26rpx;
}

.item:last-child { border-bottom: none; }

.item .k {
  flex: none;
  width: 180rpx;
  font-weight: 600;
  color: #4f46e5;
}

.item .v { flex: 1; color: #4b5563; line-height: 1.6; }

.plain {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.8;
  padding: 6rpx 0;
}

.tip {
  font-size: 24rpx;
  color: #9ca3af;
  text-align: center;
  padding: 24rpx 48rpx;
  line-height: 1.6;
}

/* 文档头：产品名 + 文档标题 */
.doc-head { padding: 36rpx 28rpx 32rpx; text-align: center; }
.doc-brand {
  font-size: 40rpx; font-weight: 700; letter-spacing: 4rpx;
  background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}
.doc-title { font-size: 30rpx; font-weight: 600; margin-top: 10rpx; color: #1f2937; }
.doc-sub { font-size: 22rpx; color: #6b7280; margin-top: 8rpx; }
