/* pages/profile/profile.wxss */

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ede9fe, #e0e7ff);
  flex-shrink: 0;
}

/* ---------- 每日目标 ---------- */
.goal-input {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  margin-right: 16rpx;
}

/* ---------- 菜单项 ---------- */
.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.menu-item:last-child { border-bottom: none; }
.menu-ill { width: 64rpx; height: 64rpx; flex-shrink: 0; }
.menu-title { font-size: 28rpx; font-weight: 600; color: #0f172a; }
.menu-desc { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; }
.menu-arrow { color: #cbd5e1; font-size: 36rpx; }

/* ---------- 弹窗 ---------- */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 100;
}
.modal {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
}
.modal-input {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.modal-link {
  text-align: center;
  color: #6366f1;
  font-size: 24rpx;
  margin: 8rpx 0 24rpx;
}
