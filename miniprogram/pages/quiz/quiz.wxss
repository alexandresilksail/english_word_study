/* pages/quiz/quiz.wxss */

/* ---------- 模式选择 ---------- */
.mode-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.mode-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 2rpx solid transparent;
}
.mode-active {
  border-color: #6366f1;
  background: #eef2ff;
}
.mode-ill { width: 88rpx; height: 88rpx; }
.mode-name { font-size: 28rpx; font-weight: 600; color: #0f172a; margin-top: 12rpx; }
.mode-desc { font-size: 20rpx; color: #94a3b8; margin-top: 6rpx; }

/* ---------- 范围 / 题量 chips ---------- */
.chip-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
}
.chip-active {
  background: linear-gradient(135deg, #8b5cf6, #6366f1);
  color: #ffffff;
  font-weight: 600;
}

/* ---------- 答题进度 ---------- */
.quiz-head { padding: 24rpx 28rpx; }

/* ---------- 题干 ---------- */
.stem-card { text-align: center; padding: 48rpx 28rpx; }
.stem-en {
  font-size: 52rpx;
  font-weight: 700;
  color: #0f172a;
  word-break: break-all;
}
.stem-cn {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
}
.stem-sub { font-size: 26rpx; color: #94a3b8; margin-top: 12rpx; }
.spell-hint {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #d97706;
  font-size: 24rpx;
}

/* ---------- 听力 ---------- */
.listen-box { padding: 24rpx 0; }
.listen-ill { width: 160rpx; height: 160rpx; margin: 0 auto 20rpx; }
.listen-btn {
  display: inline-block;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8b5cf6, #6366f1);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}
.listen-playing { opacity: 0.7; }

/* ---------- 选项 ---------- */
.option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}
.option:last-child { margin-bottom: 0; }
.option-selected { border-color: #6366f1; background: #eef2ff; }
.option-right { border-color: #16a34a; background: #dcfce7; }
.option-wrong { border-color: #dc2626; background: #fee2e2; }
.option-letter {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #475569;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.option-right .option-letter { background: #16a34a; color: #ffffff; }
.option-wrong .option-letter { background: #dc2626; color: #ffffff; }
.option-text { font-size: 28rpx; color: #1e293b; flex: 1; }

/* ---------- 拼写输入 ---------- */
.spell-input {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

/* ---------- 判题反馈 ---------- */
.feedback-right { border: 2rpx solid #16a34a; }
.feedback-wrong { border: 2rpx solid #dc2626; }
.feedback-title { font-size: 30rpx; font-weight: 700; }
.feedback-right .feedback-title { color: #16a34a; }
.feedback-wrong .feedback-title { color: #dc2626; }
.feedback-sub { font-size: 26rpx; color: #64748b; margin-top: 6rpx; }
.feedback-word { margin-top: 20rpx; }
.feedback-example {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  font-style: italic;
}

/* ---------- 退出 ---------- */
.quit-row { text-align: center; padding: 32rpx 0; }
